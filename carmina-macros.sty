\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{carmina-macros}[2026/04/18 Carmina Burana notation helpers]

% --- PACKAGES ---
\RequirePackage[a4paper, margin=2cm]{geometry}
\RequirePackage[latin]{babel}   % Latin hyphenation patterns
\RequirePackage{ebgaramond}     % EB Garamond — period-appropriate serif font
\RequirePackage[T1]{fontenc}
\RequirePackage{fancyhdr}
\RequirePackage{multicol}
\RequirePackage{leadsheets}
% Workaround: leadsheets v0.7 uses the `height' song property internally but
% never declares the underlying prop-list, which breaks with the TeX Live 2026
% LaTeX3 kernel.  Declaring it here fixes the cascade of errors at \end{song}.
\ExplSyntaxOn
\prop_if_exist:NF \l__leadsheets_songs_height_prop
  { \prop_new:N \l__leadsheets_songs_height_prop }
\ExplSyntaxOff
\RequirePackage{tikz}
% leadsheets defines \meterC; undefine before musicography loads to avoid conflict
\let\meterC\relax
\RequirePackage{musicography}
\usetikzlibrary{tikzmark, calc}

% --- 1. AUTO-MARKER ENGINE ---
\newcounter{musicverse}
\newcounter{musicmark}
\newcommand{\m}{% \m places an auto-incrementing mark: v1m1, v1m2...
  \stepcounter{musicmark}%
  \tikzmark{v\themusicverse m\themusicmark}%
}
\newcommand{\resetmusic}{%
  \stepcounter{musicverse}%
  \setcounter{musicmark}{0}%
}

% \mw{syl-la-ble} — place \m before each hyphen-delimited syllable.
% Reduces scattered \m calls; single-syllable words work too: \mw{word}.
% Edge cases that cannot use this macro: \m -- (en-dash note) and \m~ (space note).
% \markword is a verbose alias for the same macro.
\ExplSyntaxOn
\seq_new:N \l__carmina_markword_seq
\NewDocumentCommand \mw { m }
  {
    \seq_set_split:Nnn \l__carmina_markword_seq { - } { #1 }
    \seq_map_inline:Nn \l__carmina_markword_seq { \m ##1 }
  }
\let\markword\mw
\ExplSyntaxOff

% --- 1b. NOTATION LAYOUT CONSTANTS ---
% Adjust these to shift all note markings globally.
\newlength{\beamH}        \setlength{\beamH}{15pt}   % eighth-note beam height
\newlength{\beamN}        \setlength{\beamN}{3pt}    % standard horizontal nudge for beams
\newlength{\groupH}       \setlength{\groupH}{18pt}  % 16th+8th group beam height
\newlength{\sixteenH}     \setlength{\sixteenH}{20pt}% sixteenth-note group beam height
\newlength{\quarterH}     \setlength{\quarterH}{12pt}% quarter note height
\newlength{\quarterdownH} \setlength{\quarterdownH}{15pt}% stem-down quarter note height

% --- 2. DRAW MACROS ---

% \draweight{start_num}{end_num}{height}{x_nudge}
\newcommand{\draweight}[4]{%
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (A) at ($(pic cs:v\themusicverse m#1)+(#4,#3)$);
    \coordinate (B) at ($(pic cs:v\themusicverse m#2)+(#4,#3)$);
    \draw[line width=1.5pt] (A) -- (B); % Beam
    \draw[line width=0.5pt] (A) -- ($(A)-(0,8pt)$); % Start Stem
    \draw[line width=0.5pt] (B) -- ($(B)-(0,8pt)$); % End Stem
  \end{tikzpicture}%
}

% \drawsixteen{start_num}{end_num}{height}{x_nudge}
% Draws two beams and a stem for every marker in the range.
\newcommand{\drawsixteen}[4]{%
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (A) at ($(pic cs:v\themusicverse m#1)+(#4,#3)$);
    \coordinate (B) at ($(pic cs:v\themusicverse m#2)+(#4,#3)$);
    \draw[line width=1.6pt] (A) -- (B);
    \draw[line width=1.6pt] ($(A)-(0,4pt)$) -- ($(B)-(0,4pt)$);
    \foreach \i in {#1,...,#2} {
      \coordinate (S) at ($(pic cs:v\themusicverse m\i)+(#4,#3)$);
      \draw[line width=0.5pt] (S) -- ($(S)-(0,8pt)$);
    }
  \end{tikzpicture}%
}

% \drawXviViii{start}{end}{height}{nudge}
% 16th + 16th + 8th group — assumes 3 markers (e.g., m1, m2, m3).
\newcommand{\drawXviViii}[4]{%
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (A) at ($(pic cs:v\themusicverse m#1)+(#4,#3)$);
    \coordinate (B) at ($(pic cs:v\themusicverse m\the\numexpr#1+1\relax)+(#4,#3)$); % Second note
    \coordinate (C) at ($(pic cs:v\themusicverse m#2)+(#4,#3)$); % Last note
    \draw[line width=1.5pt] (A) -- (C); % Top beam (8th level) across all three
    \draw[line width=1.5pt] ($(A)-(0,4pt)$) -- ($(B)-(0,4pt)$); % Lower beam (16th level) between first two
    \foreach \i in {#1,...,#2} {
      \coordinate (S) at ($(pic cs:v\themusicverse m\i)+(#4,#3)$);
      \draw[line width=0.5pt] (S) -- ($(S)-(0,8pt)$);
    }
  \end{tikzpicture}%
}

% \drawViiiXvi{start}{end}{height}{nudge}
% 8th + 16th + 16th group.
\newcommand{\drawViiiXvi}[4]{%
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (A) at ($(pic cs:v\themusicverse m#1)+(#4,#3)$);
    \coordinate (B) at ($(pic cs:v\themusicverse m\the\numexpr#2-1\relax)+(#4,#3)$); % Second to last
    \coordinate (C) at ($(pic cs:v\themusicverse m#2)+(#4,#3)$);
    \draw[line width=1.5pt] (A) -- (C); % Top beam
    \draw[line width=1.5pt] ($(B)-(0,4pt)$) -- ($(C)-(0,4pt)$); % Lower beam at end
    \foreach \i in {#1,...,#2} {
      \coordinate (S) at ($(pic cs:v\themusicverse m\i)+(#4,#3)$);
      \draw[line width=0.5pt] (S) -- ($(S)-(0,8pt)$);
    }
  \end{tikzpicture}%
}

% \drawQuarter{mark_num}{height}
\newcommand{\drawQuarter}[2]{%
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=center, xshift=3pt, yshift=#2] at (pic cs:v\themusicverse m#1) {\musQuarter};
  \end{tikzpicture}%
}

% \drawQuarterDown{mark_num}{height} — stem-down quarter (notehead up, stem toward text)
\newcommand{\drawQuarterDown}[2]{%
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=center, xshift=3pt, yshift=#2] at (pic cs:v\themusicverse m#1) {\rotatebox{180}{\musQuarter}};
  \end{tikzpicture}%
}

% --- 3. NOTATION HELPERS ---

% Sheet-music style time signatures raised to sit with note markings.
\renewrobustcmd*\meter[2]{%
  \smash{\raisebox{13pt}{\musMeter{#1}{#2}}}%
}

% \meterbar{top}{bot} — barline + meter indication, horizontally aligned
\newcommand{\meterbar}[2]{\normalbar\kern-1pt\meter{#1}{#2}}

% \finalbar — music final barline: thin rule + thick rule
\newcommand{\finalbar}{%
  \mbox{\kern2pt\vrule width0.5pt height1.5ex depth0.4ex\kern1.5pt\vrule width2.5pt height1.5ex depth0.4ex\kern2pt}%
}

% \linenote{N} — prints [N] in the left margin without shifting the line text
\newcommand{\linenote}[1]{\smash{\llap{\small[#1]\enspace}}}

% Fermata glyph from the musix font (symbol 80 = fermata up)
\NewDocumentCommand{\musFermata}{}{\musSymbol{0em}{0.5ex}{0em}{\symbol{80}}}

% Formatting helpers
\newcommand{\chordstrut}{\vphantom{Ag}}
\newcommand{\startline}{\chord-{\chordstrut}}

% \keepverse — wraps a verse environment in an unbreakable box so it is
% never split across columns or pages.
\newenvironment{keepverse}{%
  \begin{minipage}{\linewidth}%
  \begin{verse}%
}{%
  \end{verse}%
  \end{minipage}%
  \par\medskip%
}

\newcommand{\muskern}{\kern-.15ex }
\makeatletter
\newcommand\dynmark[1]{{\normalfont\bfseries\itshape
  \@tfor\next:=#1\do{\put@muskern\next}\/}}
\newcommand{\put@muskern}{\let\put@muskern\muskern}
\makeatother

% --- 4. PAGE STYLE ---

% Work-level metadata — shared across every movement in this document.
% Override with \renewcommand in main.tex if reusing this package elsewhere.
\newcommand{\cbWorkTitle}{Carmina Burana}
\newcommand{\cbComposer}{Carl Orff}
\newcommand{\cbCompDate}{1935--36}

% Header: work info (left) + page number (right); no rule.
% Redefine plain too so leadsheets song pages match.
\fancyhf{}
\fancyhead[L]{\small\itshape\cbWorkTitle\enspace\textendash\enspace\cbComposer\ (\cbCompDate)}
\fancyfoot[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\small\itshape\cbWorkTitle\enspace\textendash\enspace\cbComposer\ (\cbCompDate)}%
  \fancyfoot[R]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}
\pagestyle{fancy}
